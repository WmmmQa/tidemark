name = "WmmmQa/tidemark"

version = "0.3.0"

readme = "README.md"

repository = "https://github.com/WmmmQa/tidemark"

license = "Apache-2.0"

keywords = [
  "integer-optimization",
  "resource-allocation",
  "cost-volume-profit",
  "management-accounting",
  "break-even",
  "scenario-analysis",
  "budget-variance",
]

preferred_target = "native"

description = "MoonBit bounded integer resource optimization with contribution planning and budget variance analysis."
